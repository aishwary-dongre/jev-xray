# Copy to .env and fill in ONE of the routes below.
# .env is gitignored. Never commit a real key, and never paste one into chat.

# --- Route 1: Vercel AI Gateway (recommended while TypeSafe signups are closed)
# Vercel dashboard -> AI Gateway -> API Keys -> create key.
# Uses Vercel's TypeSafe-compatible surface, so the request and response shapes
# are identical to TypeSafe's own API. Billed through your Vercel account.
AI_GATEWAY_API_KEY=
# Run with: jev-xray check --provider vercel
# Endpoint is built in; override only if the gateway moves it:
# JEV_XRAY_BASE_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone

# --- Route 2: TypeSafe direct (console.typesafe.ai)
# Blocked at the moment: new signups are disabled while they are over capacity.
# TYPESAFE_API_KEY=
# Run with: jev-xray check --provider typesafe

# --- Route 3: a local open reproduction serving /v1/systemone
# LitJev, openjev-sglang and others speak the same schema. No real key needed.
# JEV_XRAY_BASE_URL=http://localhost:8000/v1/systemone
# TYPESAFE_API_KEY=not-needed

# Model id. Pin a concrete version: jev-latest and jev-preview move when a
# release ships, which silently invalidates any threshold tuned against them.
# On the Vercel gateway the id may need to be typesafe-ai/jev instead; `check`
# will say so if the body is rejected.
JEV_XRAY_MODEL=jev-1.13.0
